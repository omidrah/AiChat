# ============================================================
# AiChat — unified root .gitignore
# Covers the whole repo: .NET backend + Angular frontend.
# (Single file at the root; no per-project .gitignore files.)
# ============================================================

# ---- OS / system files ----
.DS_Store
Thumbs.db
Desktop.ini
*.stackdump

# ---- Editors / IDEs ----
.idea/
*.sublime-workspace
.project
.classpath
.settings/
*.launch
*.suo
*.user
*.userosscache
*.userprefs
*.sln.docstates

# .vscode (keep shared workspace settings)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json

.history/
__screenshots__/

# ---- .NET / Visual Studio ----
# Build output
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/
.vs/

# Tooling / cache
*.user
*.suo
*.pdb
*.cache
*.nupkg
*.snupkg
*.binlog
TestResults/
BenchmarkDotNet.Artifacts/
coverage*.json
coverage*.xml
*.trx
node_modules/

# ---- Publish profiles (local machine settings) ----
*.pubxml
*.azurePubxml
PublishScripts/

# ---- Node / Angular ----
npm-debug.log
yarn-error.log
dist/
tmp/
out-tsc/
bazel-out/
.angular/
coverage/
typings/
testem.log
libpeerconnection.log
connect.lock
.sass-cache/

# ---- SQLite databases (runtime chat data) ----
*.db
*.db-shm
*.db-wal
